{
  "name": "waraxe-mobile",
  "version": "17.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "server": "npm run dev -w server",
    "server:build": "npm run build -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "test:static": "node scripts/smoke-check.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "db:push": "npm run db:push -w server"
  },
  "dependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.14",
    "typescript": "5.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "^0.468.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {}
}
